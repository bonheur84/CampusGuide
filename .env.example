# Backend environment example
# Copy this file to backend/.env and adapt the values to your local setup.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=campusguide
DB_PORT=3306

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
PORT=3001

# Frontend environment example
# Copy this file to frontend/.env if you want a direct override.
VITE_API_URL=http://localhost:3001/api
